<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Account Disabled - SEBA GHOR</title>
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Hind Siliguri',sans-serif}
body{
  min-height:100vh;
  background:#1a1a3e;
  background-image:
    radial-gradient(circle at 20% 20%, rgba(217,70,239,.25), transparent 50%),
    radial-gradient(circle at 80% 80%, rgba(0,229,255,.2), transparent 50%),
    radial-gradient(circle at 50% 50%, rgba(15,23,42,.9), transparent 70%);
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px;
}
.popup{
  background:linear-gradient(160deg,#1e1b4b,#0f172a);
  border:2px solid #dc2626;
  border-radius:24px;
  padding:40px 28px 32px;
  max-width:420px;
  width:100%;
  text-align:center;
  box-shadow:0 0 60px rgba(220,38,38,.35), 0 0 100px rgba(217,70,239,.2);
  position:relative;
  animation:popIn .5s ease;
}
@keyframes popIn{from{transform:scale(.85);opacity:0}to{transform:scale(1);opacity:1}}
.popup-icon{
  width:100px;height:100px;border-radius:50%;
  background:linear-gradient(135deg,#ef4444,#dc2626);
  display:flex;align-items:center;justify-content:center;
  margin:0 auto 22px;font-size:60px;font-weight:900;color:#fff;
  box-shadow:0 0 40px rgba(220,38,38,.7), inset 0 -8px 20px rgba(0,0,0,.2);
  position:relative;animation:pulse 2s ease-in-out infinite;
}
@keyframes pulse{
  0%,100%{box-shadow:0 0 40px rgba(220,38,38,.7), inset 0 -8px 20px rgba(0,0,0,.2)}
  50%{box-shadow:0 0 60px rgba(220,38,38,1), inset 0 -8px 20px rgba(0,0,0,.2)}
}
.popup-icon::after{
  content:"";position:absolute;top:12px;left:18px;
  width:24px;height:14px;background:rgba(255,255,255,.35);
  border-radius:50%;transform:rotate(-25deg);filter:blur(2px);
}
.popup h2{
  color:#ef4444;font-size:26px;font-weight:800;margin-bottom:24px;
  text-shadow:0 0 20px rgba(239,68,68,.5);
}
.popup .msg{color:#e2e8f0;font-size:16px;line-height:1.7;margin-bottom:10px}
.popup .msg b{color:#38bdf8;font-weight:700}
.popup .msg .red{color:#ef4444;font-weight:700}
.popup .sub{color:#cbd5e1;font-size:15px;margin:20px 0 26px}
.btn{
  display:flex;align-items:center;justify-content:center;gap:10px;
  width:100%;padding:15px;border:0;border-radius:14px;
  font-size:16px;font-weight:800;cursor:pointer;font-family:inherit;
  text-decoration:none;transition:.25s;
}
.btn-whatsapp{
  background:linear-gradient(135deg,#10b981,#059669);color:#fff;
  margin-bottom:12px;box-shadow:0 6px 20px rgba(16,185,129,.4);
}
.btn-whatsapp:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(16,185,129,.6)}
.btn-logout{
  background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff;
  box-shadow:0 6px 20px rgba(220,38,38,.4);
}
.btn-logout:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(220,38,38,.6)}
@media(max-width:480px){
  .popup{padding:32px 20px 24px}
  .popup h2{font-size:22px}
  .popup-icon{width:80px;height:80px;font-size:48px}
}
</style>
</head>
<body>

<%
  // WhatsApp নাম্বার ফরম্যাট ঠিক করা
  let adminNumber = (setting && setting.whatsappAdmin) ? String(setting.whatsappAdmin) : '';
  adminNumber = adminNumber.replace(/\D/g, ''); // শুধু ডিজিট রাখবো
  if (adminNumber.startsWith('01')) {
    adminNumber = '88' + adminNumber; // 01 → 8801
  } else if (adminNumber.startsWith('1') && adminNumber.length === 10) {
    adminNumber = '88' + adminNumber; // 1XXXXXXXXX → 881XXXXXXXXX
  }

  // অটো মেসেজ
  const waMessage = `আসসালামু আলাইকুম,\n\nআমি ${user.name}।\nআমি নতুন অ্যাকাউন্ট খুলছি। আমার একাউন্টটি এক্টিভ করে দেন।`;

  const waLink = adminNumber
    ? `https://wa.me/${adminNumber}?text=${encodeURIComponent(waMessage)}`
    : 'https://wa.me/?text=' + encodeURIComponent(waMessage);
%>

<div class="popup">
  <div class="popup-icon">−</div>

  <h2>একাউন্ট নিষ্ক্রিয়</h2>

  <p class="msg">
    প্রিয় <b><%= user.name %></b>, আপনার একাউন্টটি এখনো
    <span class="red">একটিভ</span> করা হয়নি।
  </p>

  <p class="sub">এডমিনের সাথে যোগাযোগ করুন।</p>

  <a target="_blank" href="<%= waLink %>" class="btn btn-whatsapp">
    💬 এডমিনের সাথে WhatsApp
  </a>

  <a href="/logout" class="btn btn-logout">
    ✕ লগআউট
  </a>
</div>

</body></html>