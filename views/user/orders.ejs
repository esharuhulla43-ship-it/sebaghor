<%- include('../partials/head', { cssFile: 'dashboard.css', bodyClass: 'dash' }) %>

<div class="topbar">
  <div class="left"><a href="/user/dashboard" style="color:#0f5132;font-weight:700">⬅ ফিরে যান</a></div>
  <div class="right"><div class="balance-chip">💼 <div><small>My Balance</small><b>৳ <%= user.balance.toFixed(2) %></b></div></div></div>
</div>

<div class="section">
  <div class="section-title">🧾 আমার অর্ডার লিস্ট</div>

  <% if (!orders || orders.length === 0) { %>
    <p style="color:#64748b">আপনার কোনো অর্ডার নেই।</p>
  <% } else { %>
    <div class="small-grid">
      <% orders.forEach(o => { %>
        <% 
          let statusText = '';
          let statusColor = '';
          if (o.status === 'completed') {
            statusText = '✅ কমপ্লিট';
            statusColor = 'background:#d1fae5;color:#065f46';
          } else if (o.status === 'cancelled') {
            statusText = '❌ ক্যান্সেল';
            statusColor = 'background:#fee2e2;color:#991b1b';
          } else {
            statusText = '⏳ পেন্ডিং';
            statusColor = 'background:#fef3c7;color:#92400e';
          }
        %>
        <div class="small-card" style="cursor:default;flex-direction:column;align-items:flex-start;gap:8px;padding:18px;<%= o.status === 'cancelled' ? 'border:2px dashed #dc2626;background:#fef2f2;opacity:.85' : '' %>">
          <div style="display:flex;justify-content:space-between;width:100%;align-items:center">
            <b>
              <% if (o.service) { %>
                🛠️ <%= o.service.name %>
              <% } else if (o.product) { %>
                📦 <%= o.product.name %>
              <% } else { %>
                ❓ অর্ডার
              <% } %>
            </b>
            <span style="padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;<%= statusColor %>">
              <%= statusText %>
            </span>
          </div>
          <p style="font-size:13px;color:#64748b">
            💰 দাম: <b style="color:#10b981">৳ <%= o.price || o.selectedPrice || 0 %></b><br>
            <% if (o.selectedOption) { %>📝 অপশন: <%= o.selectedOption %><br><% } %>
            <% if (o.details) { %>📋 বিস্তারিত: <%= o.details %><br><% } %>
            🕐 <%= o.createdAt ? o.createdAt.toLocaleString('bn-BD') : '' %>
          </p>

          <% if (o.status === 'cancelled') { %>
            <div style="width:100%;background:#fff;border-left:4px solid #dc2626;padding:12px;border-radius:8px">
              <b style="color:#dc2626;font-size:12px">❌ ক্যান্সেল কারণ:</b>
              <p style="font-size:13px;color:#0f172a;margin-top:4px"><%= o.cancelReason || 'কারণ উল্লেখ করা হয়নি' %></p>
            </div>
          <% } %>

          <% if (o.status === 'completed') { %>
            <a href="/user/download/<%= o._id %>" style="width:100%">
              <button class="btn-yellow" style="width:100%;justify-content:center;font-size:13px;padding:10px">⬇️ ডাউনলোড করুন</button>
            </a>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

</body></html>