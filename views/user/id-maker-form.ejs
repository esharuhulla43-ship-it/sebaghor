<%- include('../partials/head', { cssFile: 'dashboard.css', bodyClass: 'dash' }) %>

<div class="topbar">
  <div class="left"><a href="/user/id-maker" style="color:#0f5132;font-weight:700">⬅ ফিরে যান</a></div>
  <div class="right"><div class="balance-chip">💼 <div><small>Balance</small><b>৳ <%= user.balance.toFixed(2) %></b></div></div></div>
</div>

<div class="section" style="max-width:900px;margin:20px auto">
  <div class="section-title">🪪 <%= template.name %> — তথ্য পূরণ করুন</div>

  <div class="small-card" style="cursor:default;padding:20px;margin-bottom:16px">
    <img src="/uploads/<%= template.templateImage %>" alt="Template" style="width:100%;max-height:300px;object-fit:contain;border-radius:8px;border:1px solid #d1fae5">
    <p style="text-align:center;color:#10b981;font-weight:700;font-size:18px;margin-top:10px">দাম: ৳ <%= template.price %></p>
  </div>

  <% if (error && error.length) { %>
    <div class="flash error" style="margin-bottom:14px"><%= error %></div>
  <% } %>

  <form method="POST" action="/user/id-maker/fill/<%= template._id %>" enctype="multipart/form-data" style="display:flex;flex-direction:column;gap:14px">

    <div style="background:#f0fdf4;padding:16px;border-radius:10px">
      <b style="color:#0f5132;display:block;margin-bottom:10px">📷 ছবি ও স্বাক্ষর</b>
      <div class="flex2">
        <div class="form-row">
          <label>আইডি ফটো আপলোড করুন</label>
          <input type="file" name="photoFile" accept="image/*" required style="padding:9px;border:1px solid #d1fae5;border-radius:6px;font-family:inherit;background:#fff">
        </div>
        <div class="form-row">
          <label>আইডি সাক্ষর আপলোড করুন</label>
          <input type="file" name="signatureFile" accept="image/*" style="padding:9px;border:1px solid #d1fae5;border-radius:6px;font-family:inherit;background:#fff">
        </div>
      </div>
    </div>

    <div class="flex2">
      <div class="form-row"><label>আইডি নাম্বার</label><input name="idNumber" required style="padding:11px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit"></div>
      <div class="form-row"><label>পিন নাম্বার</label><input name="pinNumber" style="padding:11px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit"></div>
      <div class="form-row"><label>নাম (বাংলা)</label><input name="nameBangla" required style="padding:11px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit"></div>
      <div class="form-row"><label>নাম (ইংরেজি)</label><input name="nameEnglish" style="padding:11px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit"></div>
      <div class="form-row"><label>জন্ম তারিখ</label><input name="birthDate" type="date" style="padding:11px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit"></div>
      <div class="form-row"><label>জন্মস্থান</label><input name="birthPlace" style="padding:11px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit"></div>
      <div class="form-row"><label>পিতার নাম</label><input name="fatherName" style="padding:11px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit"></div>
      <div class="form-row"><label>মাতার নাম</label><input name="motherName" style="padding:11px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit"></div>
      <div class="form-row"><label>লিঙ্গ</label>
        <select name="gender" style="padding:11px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit">
          <option value="">-- সিলেক্ট --</option>
          <option>পুরুষ</option>
          <option>মহিলা</option>
          <option>অন্যান্য</option>
        </select>
      </div>
      <div class="form-row"><label>রক্তের গ্রুপ</label>
        <select name="bloodGroup" style="padding:11px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit">
          <option value="">-- সিলেক্ট --</option>
          <option>A+</option><option>A-</option>
          <option>B+</option><option>B-</option>
          <option>O+</option><option>O-</option>
          <option>AB+</option><option>AB-</option>
        </select>
      </div>
      <div class="form-row"><label>ইস্যু তারিখ</label><input name="issueDate" type="date" style="padding:11px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit"></div>
    </div>

    <div class="form-row">
      <label>ঠিকানা</label>
      <textarea name="address" rows="3" style="padding:11px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit;resize:vertical"></textarea>
    </div>

    <div style="background:#fef3c7;padding:14px;border-radius:10px;text-align:center">
      <b style="color:#92400e">⚠️ ডাউনলোড করলে ৳<%= template.price %> কাটা হবে</b>
    </div>

    <button class="btn-yellow" type="submit" style="justify-content:center;padding:14px;font-size:16px">✅ প্রিভিউ দেখুন</button>
  </form>
</div>

</body></html>