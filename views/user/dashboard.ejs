<%- include('../partials/head', { cssFile: 'dashboard.css', bodyClass: 'dash' }) %>

<div class="topbar">
  <div class="left"><a href="/logout" class="logout">➜ লগআউট</a></div>
  <div class="right">
    <div class="balance-chip">💼 <div><small>My Balance</small><b>৳ <%= user.balance.toFixed(2) %></b></div></div>
    <a href="/user/recharge"><button class="btn-outline-green">💰 রিচার্জ</button></a>
    <a href="/user/orders"><button class="btn-outline-green">🧾 অর্ডার</button></a>
  </div>
</div>

<div class="banner">
  <div class="user-info">
    <div class="avatar">👤</div>
    <div>
      <h1>স্বাগতম, <%= user.name %> 👋</h1>
      <p>আপনার প্রয়োজনীয় সেবাগুলো নিতে তালিকাভুক্ত করা হয়েছে।</p>
    </div>
  </div>
  <div class="actions">
    <a href="/user/recharge"><button class="btn-yellow">💼 রিচার্জ</button></a>
    <a href="/user/profile"><button class="btn-ghost">👤 প্রোফাইল ➜</button></a>
  </div>
</div>

<div class="section">
  <div class="section-title">📦 আমাদের সেবাসমূহ</div>

  <% if (!services || services.length === 0) { %>
    <p style="color:#64748b">এখনো কোনো সেবা যোগ করা হয়নি।</p>
  <% } else { %>
    <div class="small-grid" style="grid-template-columns:repeat(auto-fill,minmax(260px,1fr))">
      <% services.forEach(s => { %>
        <a href="/user/service/<%= s._id %>" class="small-card" style="padding:16px">
          <div style="width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,#ecfdf5,#d1fae5);display:flex;align-items:center;justify-content:center;font-size:26px;flex-shrink:0"><%= s.icon || '🛠️' %></div>
          <div class="small-txt" style="flex:1">
            <h4 style="font-size:14.5px;font-weight:800"><%= s.name %></h4>
            <p style="font-size:11.5px"><%= s.category %></p>
          </div>
          <span class="small-arrow">➜</span>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>

</body></html>