<%- include('../partials/head', { cssFile: 'dashboard.css', bodyClass: 'dash' }) %>

<div class="topbar">
  <div class="left"><a href="/logout" class="logout">➜ লগআউট</a></div>
  <div class="right">
    <div class="balance-chip">💼 <div><small>ব্যালেন্স</small><b>৳ <%= user.balance.toFixed(2) %></b></div></div>
    <a href="/user/recharge"><button class="btn-outline-green">💰 রিচার্জ</button></a>
    <a href="/user/orders"><button class="btn-outline-green">🧾 সকল অর্ডার লিস্ট</button></a>
  </div>
</div>

<div class="banner">
  <div class="user-info">
    <div class="avatar">👤</div>
    <div>
      <h1>স্বাগতম, <%= user.name %> 👋</h1>
      <p>আপনার প্রয়োজনীয় সেবাগুলো নিতে তালিকাভুক্ত করা হয়েছে।</p>
    </div>
  </div>
  <div class="actions">
    <a href="/user/recharge"><button class="btn-yellow">💼 রিচার্জ</button></a>
    <a href="/user/profile"><button class="btn-ghost">👤 প্রোফাইল ➜</button></a>
  </div>
</div>

<div class="section">
  <div class="section-title">📦 আমাদের সেবাসমূহ</div>

  <% if (!services || services.length === 0) { %>
    <p style="color:#64748b">এখনো কোনো সেবা যোগ করা হয়নি।</p>
  <% } else { %>
    <div class="small-grid">
      <% services.forEach(s => { %>
        <a href="/user/service/<%= s._id %>" class="small-card">
          <div class="small-ic" style="background:#ecfdf5;color:#10b981;font-size:22px">🛠️</div>
          <div class="small-txt">
            <h4><%= s.name %></h4>
            <p>📁 <%= s.category %></p>
          </div>
          <span class="small-arrow">➜</span>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>

</body></html>