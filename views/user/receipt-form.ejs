<%- include('../partials/head', { cssFile: 'dashboard.css', bodyClass: 'dash' }) %>

<div class="topbar">
  <div class="left"><a href="/user/dashboard" style="color:#0f5132;font-weight:700">⬅ ফিরে যান</a></div>
  <div class="right"><div class="balance-chip">💼 <div><small>Balance</small><b>৳ <%= user.balance.toFixed(2) %></b></div></div></div>
</div>

<div class="section" style="max-width:800px;margin:20px auto">
  <div class="section-title">🧾 নতুন রিসিভ তৈরি করুন</div>

  <div class="small-card" style="cursor:default;padding:24px">
    <form method="POST" action="/user/create-receipt" style="display:flex;flex-direction:column;gap:12px">
      
      <div class="flex2">
        <div class="form-row">
          <label>কাস্টমারের নাম *</label>
          <input name="customerName" required style="padding:11px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit">
        </div>
        <div class="form-row">
          <label>কাস্টমারের মোবাইল নাম্বার</label>
          <input name="customerMobile" style="padding:11px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit">
        </div>
      </div>

      <div class="form-row">
        <label>ঠিকানা</label>
        <input name="customerAddress" style="padding:11px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit">
      </div>

      <div class="flex2">
        <div class="form-row">
          <label>SMS অ্যাকাউন্ট নাম্বার</label>
          <input name="smsAccount" style="padding:11px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit">
        </div>
        <div class="form-row">
          <label>ট্রানজেকশন আইডি (TrxID)</label>
          <input name="transactionId" style="padding:11px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit">
        </div>
      </div>

      <div style="background:#f0fdf4;padding:16px;border-radius:10px;margin-top:10px">
        <b style="color:#0f5132;display:block;margin-bottom:10px">💰 টাকার হিসাব</b>
        <div class="flex2">
          <div class="form-row">
            <label>বিদ্যুৎ বিল (৳) *</label>
            <input name="billAmount" type="number" required style="padding:11px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit">
          </div>
          <div class="form-row">
            <label>চার্জ (৳) *</label>
            <input name="chargeAmount" type="number" required style="padding:11px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit">
          </div>
        </div>
      </div>

      <button class="btn-yellow" type="submit" style="justify-content:center;padding:14px;font-size:16px;margin-top:10px">✅ রিসিভ তৈরি করুন</button>
    </form>
  </div>
</div>

</body></html>