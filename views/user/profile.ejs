<%- include('../partials/head', { cssFile: 'dashboard.css', bodyClass: 'dash' }) %>

<div class="topbar">
  <div class="left"><a href="/user/dashboard" style="color:#0f5132;font-weight:700">⬅ ফিরে যান</a></div>
</div>

<div class="section" style="max-width:600px;margin:30px auto">
  <div class="section-title">👤 আমার প্রোফাইল</div>

  <% if (success && success.length) { %><div class="flash success" style="background:#d1fae5;color:#065f46;padding:12px;border-radius:8px;margin-bottom:14px;text-align:center"><%= success %></div><% } %>

  <div class="small-card" style="cursor:default;flex-direction:column;align-items:flex-start;gap:14px;padding:24px">
    <div style="display:flex;align-items:center;gap:16px">
      <div style="width:70px;height:70px;border-radius:50%;background:#d1fae5;color:#0f5132;display:flex;align-items:center;justify-content:center;font-size:32px">👤</div>
      <div>
        <h2 style="font-size:20px;margin-bottom:4px"><%= user.name %></h2>
        <p style="color:#10b981;font-weight:700">ব্যালেন্স: ৳ <%= user.balance.toFixed(2) %></p>
      </div>
    </div>
    <hr style="width:100%;border:none;border-top:1px solid #d1fae5">
    <p style="font-size:14px"><b>📱 মোবাইল:</b> <%= user.mobile %></p>
    <p style="font-size:14px"><b>✉ ইমেইল:</b> <%= user.email %></p>
    <p style="font-size:14px"><b>🔓 আইডি স্ট্যাটাস:</b> <%= user.isActive ? '✅ একটিভ' : '❌ ডিএকটিভ' %></p>
    <a href="/user/change-password" style="width:100%"><button class="btn-yellow" style="width:100%;justify-content:center">🔑 পাসওয়ার্ড পরিবর্তন করুন</button></a>
  </div>
</div>
</body></html>