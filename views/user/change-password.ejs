<%- include('../partials/head', { cssFile: 'dashboard.css', bodyClass: 'dash' }) %>

<div class="topbar">
  <div class="left"><a href="/user/profile" style="color:#0f5132;font-weight:700">⬅ ফিরে যান</a></div>
</div>

<div class="section" style="max-width:500px;margin:40px auto">
  <div class="section-title">🔑 পাসওয়ার্ড পরিবর্তন</div>

  <% if (error && error.length) { %>
    <div style="background:#fee2e2;color:#991b1b;padding:12px;border-radius:8px;margin-bottom:14px;text-align:center"><%= error %></div>
  <% } %>

  <% if (step === 1) { %>
    <div class="small-card" style="cursor:default;flex-direction:column;align-items:flex-start;gap:14px;padding:24px">
      <h3 style="font-size:17px;color:#0f5132">বর্তমান পাসওয়ার্ড দিন</h3>
      <p style="color:#64748b;font-size:13px">আপনার বর্তমান পাসওয়ার্ড যাচাই করা হবে</p>
      <form method="POST" action="/user/change-password/verify" style="width:100%;display:flex;flex-direction:column;gap:12px">
        <div style="position:relative;width:100%">
          <input type="password" name="currentPassword" id="pwA" placeholder="বর্তমান পাসওয়ার্ড" required style="width:100%;padding:12px 44px 12px 14px;border:1px solid #d1fae5;border-radius:10px;font-family:inherit;font-size:14px">
          <span onclick="togglePw('pwA',this)" style="position:absolute;right:14px;top:50%;transform:translateY(-50%);cursor:pointer;color:#10b981;font-size:16px">👁</span>
        </div>
        <button class="btn-yellow" style="justify-content:center;padding:13px;font-size:15px">➜ পরবর্তী</button>
      </form>
    </div>
  <% } else { %>
    <div class="small-card" style="cursor:default;flex-direction:column;align-items:flex-start;gap:14px;padding:24px">
      <h3 style="font-size:17px;color:#0f5132">নতুন পাসওয়ার্ড দিন</h3>
      <form method="POST" action="/user/change-password/save" id="pwForm" style="width:100%;display:flex;flex-direction:column;gap:12px">
        <div>
          <label style="font-size:13px;color:#64748b;display:block;margin-bottom:6px">নতুন পাসওয়ার্ড দিন</label>
          <div style="position:relative">
            <input type="password" name="newPassword" id="pwN" required style="width:100%;padding:12px 44px 12px 14px;border:1px solid #d1fae5;border-radius:10px;font-family:inherit;font-size:14px">
            <span onclick="togglePw('pwN',this)" style="position:absolute;right:14px;top:50%;transform:translateY(-50%);cursor:pointer;color:#10b981;font-size:16px">👁</span>
          </div>
        </div>
        <div>
          <label style="font-size:13px;color:#64748b;display:block;margin-bottom:6px">কনফার্ম পাসওয়ার্ড দিন</label>
          <div style="position:relative">
            <input type="password" name="confirmPassword" id="pwC" required style="width:100%;padding:12px 44px 12px 14px;border:1px solid #d1fae5;border-radius:10px;font-family:inherit;font-size:14px">
            <span onclick="togglePw('pwC',this)" style="position:absolute;right:14px;top:50%;transform:translateY(-50%);cursor:pointer;color:#10b981;font-size:16px">👁</span>
          </div>
        </div>
        <button class="btn-yellow" style="justify-content:center;padding:13px;font-size:15px">✅ সেভ করুন</button>
        <p style="font-size:12px;color:#64748b;text-align:center">পাসওয়ার্ড মিলে গেলে স্বয়ংক্রিয়ভাবে সেভ হয়ে যাবে</p>
      </form>
    </div>
  <% } %>
</div>

<script>
function togglePw(id, el){
  const i = document.getElementById(id);
  if(i.type === 'password'){ i.type='text'; el.textContent='🙈'; }
  else { i.type='password'; el.textContent='👁'; }
}

// কনফার্ম পাসওয়ার্ড মিললে অটো সেভ
const form = document.getElementById('pwForm');
if(form){
  const n = document.getElementById('pwN');
  const c = document.getElementById('pwC');
  c.addEventListener('input', () => {
    if(n.value && c.value && n.value === c.value){
      setTimeout(() => form.submit(), 400);
    }
  });
}
</script>
</body></html>