<%- include('../partials/head', { cssFile: 'dashboard.css', bodyClass: 'dash' }) %>

<div class="topbar">
  <div class="left"><a href="/logout" class="logout">➜ লগআউট</a></div>
  <div class="right"><b style="color:#0f5132">👑 এডমিন প্যানেল</b></div>
</div>

<% if (success && success.length) { %>
  <div class="section"><div style="background:#d1fae5;color:#065f46;padding:12px;border-radius:8px;text-align:center"><%= success %></div></div>
<% } %>
<% if (error && error.length) { %>
  <div class="section"><div style="background:#fee2e2;color:#991b1b;padding:12px;border-radius:8px;text-align:center"><%= error %></div></div>
<% } %>

<!-- ============= ড্যাশবোর্ড ============= -->
<div class="section">
  <div class="section-title">📊 ড্যাশবোর্ড</div>
  <div class="big-grid">
    <div class="big-card" style="cursor:default"><h3 style="font-size:28px;color:#10b981"><%= users.length %></h3><p>মোট ইউজার</p></div>
    <div class="big-card" style="cursor:default"><h3 style="font-size:28px;color:#10b981"><%= products.length %></h3><p>মোট প্রোডাক্ট</p></div>
    <div class="big-card" style="cursor:default"><h3 style="font-size:28px;color:#10b981"><%= orders.length %></h3><p>মোট অর্ডার</p></div>
    <div class="big-card" style="cursor:default"><h3 style="font-size:28px;color:#f59e0b"><%= orders.filter(o=>o.status==='pending').length %></h3><p>পেন্ডিং অর্ডার</p></div>
  </div>
</div>

<!-- ============= কুইক লিংক ============= -->
<div class="section" style="text-align:center">
  <a href="/admin/services" class="btn-yellow" style="display:inline-flex;text-decoration:none;padding:12px 24px;margin:6px;font-size:15px">
    🛠️ সার্ভিস ম্যানেজমেন্ট
  </a>
  <a href="/admin/recharges" class="btn-yellow" style="display:inline-flex;text-decoration:none;padding:12px 24px;margin:6px;font-size:15px">
    💰 রিচার্জ ম্যানেজমেন্ট
  </a>
</div>

<!-- ============= অর্ডার লিস্ট ============= -->
<div class="section" id="orders">
  <div class="section-title">🧾 অর্ডার লিস্ট</div>
  <% if (!orders || orders.length === 0) { %>
    <p style="color:#64748b">কোনো অর্ডার নেই।</p>
  <% } else { %>
    <div class="small-grid">
      <% orders.forEach(o => { %>
        <div class="small-card" style="cursor:default;flex-direction:column;align-items:flex-start;gap:10px;padding:18px;<%= o.status === 'cancelled' ? 'border:2px dashed #dc2626;background:#fef2f2;opacity:.85' : '' %>">
          
          <div style="display:flex;justify-content:space-between;width:100%;align-items:center">
            <b style="font-size:14px">
              <% if (o.service) { %>
                🛠️ <%= o.service.name %>
              <% } else if (o.product) { %>
                📦 <%= o.product.name %>
              <% } else { %>
                ❓ অজানা
              <% } %>
            </b>
            <span style="padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;<%= o.status === 'completed' ? 'background:#d1fae5;color:#065f46' : (o.status === 'cancelled' ? 'background:#fee2e2;color:#991b1b' : 'background:#fef3c7;color:#92400e') %>">
              <%= o.status === 'completed' ? '✅ কমপ্লিট' : (o.status === 'cancelled' ? '❌ ক্যান্সেল' : '⏳ পেন্ডিং') %>
            </span>
          </div>

          <p style="font-size:13px;color:#64748b;width:100%">
            👤 <%= o.user ? o.user.name : '?' %> | 📱 <%= o.user ? o.user.mobile : '-' %><br>
            💰 ৳ <%= o.price || o.selectedPrice || 0 %>
            <% if (o.selectedOption) { %><br>📝 <%= o.selectedOption %><% } %>
            <% if (o.details) { %><br>📋 <%= o.details %><% } %>
          </p>

          <% if (o.status === 'cancelled') { %>
            <div style="width:100%;background:#fff;border-left:4px solid #dc2626;padding:10px;border-radius:8px">
              <b style="color:#dc2626;font-size:12px">❌ ক্যান্সেল কারণ:</b>
              <p style="font-size:12px;color:#0f172a;margin-top:4px"><%= o.cancelReason || 'কারণ নেই' %></p>
            </div>
          <% } %>

          <% if (o.status === 'pending') { %>
            <form method="POST" action="/admin/orders/complete/<%= o._id %>" enctype="multipart/form-data" style="display:flex;flex-direction:column;gap:6px;width:100%">
              <textarea name="adminText" placeholder="টেক্সট (ঐচ্ছিক)" style="padding:7px;border:1px solid #d1fae5;border-radius:6px;font-family:inherit;font-size:12px" rows="2"></textarea>
              <input type="file" name="adminPdf" style="font-size:11px">
              <input type="file" name="adminImage" style="font-size:11px">
              <button class="btn-yellow" style="justify-content:center;font-size:12px;padding:8px">✅ কমপ্লিট করুন</button>
            </form>

            <form method="POST" action="/admin/orders/cancel/<%= o._id %>" style="width:100%;display:flex;flex-direction:column;gap:6px" onsubmit="return confirm('অর্ডার ক্যান্সেল করবেন?\n\n✅ ৳<%= o.price || o.selectedPrice || 0 %> অটো ইউজারের ব্যালেন্সে ফেরত যাবে।')">
              <textarea name="cancelReason" placeholder="ক্যান্সেল করার কারণ লিখুন (যেমন: এই ফাইলটি বর্তমানে নেই)" required rows="2" style="padding:7px;border:1px solid #f59e0b;border-radius:6px;font-family:inherit;font-size:12px;resize:vertical"></textarea>
              <button class="btn-ghost" style="width:100%;justify-content:center;font-size:12px;padding:8px;background:#f59e0b;border-color:#f59e0b;color:#fff">↩️ ক্যান্সেল ও রিফান্ড</button>
            </form>
          <% } %>

          <form method="POST" action="/admin/orders/delete/<%= o._id %>" onsubmit="return confirm('অর্ডারটি স্থায়ীভাবে ডিলিট করবেন?\n\n⚠️ ইউজার আর এই অর্ডার দেখতে পাবে না।')" style="width:100%">
            <button class="btn-ghost" style="width:100%;justify-content:center;font-size:12px;padding:8px;background:#dc2626;border-color:#dc2626;color:#fff">🗑️ স্থায়ীভাবে ডিলিট</button>
          </form>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- ============= সাইট সেটিংস ============= -->
<div class="section" id="settings">
  <div class="section-title">⚙️ সাইট সেটিংস</div>
  <div class="small-card" style="cursor:default;flex-direction:column;gap:10px;padding:20px">
    <form method="POST" action="/admin/settings" style="display:grid;grid-template-columns:1fr 1fr;gap:10px;width:100%">
      <input name="siteName" value="<%= setting.siteName || '' %>" placeholder="সাইটের নাম" style="padding:10px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit">
      <input name="tagline" value="<%= setting.tagline || '' %>" placeholder="ট্যাগলাইন" style="padding:10px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit">
      <input name="bkashNumber" value="<%= setting.bkashNumber || '' %>" placeholder="বিকাশ নাম্বার" style="padding:10px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit">
      <input name="nagadNumber" value="<%= setting.nagadNumber || '' %>" placeholder="নগদ নাম্বার" style="padding:10px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit">
      <input name="paymentNumber" value="<%= setting.paymentNumber || '' %>" placeholder="পেমেন্ট নাম্বার" style="padding:10px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit">
      <input name="whatsappSupport" value="<%= setting.whatsappSupport || '' %>" placeholder="সাপোর্ট WhatsApp (8801...)" style="padding:10px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit">
      <input name="whatsappAdmin" value="<%= setting.whatsappAdmin || '' %>" placeholder="এডমিন WhatsApp (8801...)" style="grid-column:1/-1;padding:10px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit">
      <input name="marqueeText" value="<%= setting.marqueeText || '' %>" placeholder="📢 স্ক্রলিং নোটিশ" style="grid-column:1/-1;padding:10px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit">
      <button class="btn-yellow" style="grid-column:1/-1;justify-content:center;padding:11px">💾 সেটিংস সেভ করুন</button>
    </form>
  </div>
</div>

</body></html>