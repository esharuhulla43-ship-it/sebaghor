<%- include('../partials/head', { cssFile: 'dashboard.css', bodyClass: 'dash' }) %>

<div class="topbar">
  <div class="left"><a href="/admin/dashboard" style="color:#0f5132;font-weight:700">⬅ ড্যাশবোর্ডে ফিরুন</a></div>
  <div class="right"><b style="color:#0f5132">🛠️ সার্ভিস ম্যানেজমেন্ট</b></div>
</div>

<div class="section">
  <div class="section-title">➕ নতুন সার্ভিস যোগ করুন</div>
  <div class="small-card" style="cursor:default;padding:20px">
    <form method="POST" action="/admin/services/add" style="display:flex;flex-direction:column;gap:12px">
      <div style="display:grid;grid-template-columns:80px 1fr 1fr;gap:10px">
        <input name="icon" placeholder="🎯" maxlength="4" style="padding:11px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit;font-size:20px;text-align:center">
        <input name="name" placeholder="সার্ভিসের নাম" required style="padding:11px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit">
        <input name="category" placeholder="ক্যাটাগরি" required style="padding:11px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit">
      </div>
      <input name="description" placeholder="বর্ণনা (ঐচ্ছিক)" style="padding:11px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit">

      <div style="background:#f0fdf4;padding:14px;border-radius:10px">
        <b style="color:#0f5132;font-size:14px">💰 অপশন ও দাম</b>
        <div id="optionsBox" style="margin-top:10px">
          <div class="option-row" style="display:flex;gap:8px;margin-bottom:8px">
            <input name="optionLabels" placeholder="অপশনের নাম" value="স্ট্যান্ডার্ড" style="flex:2;padding:9px;border:1px solid #d1fae5;border-radius:6px;font-family:inherit">
            <input name="optionPrices" type="number" placeholder="দাম" style="flex:1;padding:9px;border:1px solid #d1fae5;border-radius:6px;font-family:inherit">
            <button type="button" onclick="removeOption(this)" style="padding:9px 12px;background:#dc2626;color:#fff;border:0;border-radius:6px;cursor:pointer">✕</button>
          </div>
        </div>
        <button type="button" onclick="addOption()" style="padding:8px 14px;background:#10b981;color:#fff;border:0;border-radius:6px;cursor:pointer;font-size:13px;font-family:inherit">+ আরো অপশন</button>
      </div>

      <button class="btn-yellow" style="justify-content:center;padding:12px;font-size:15px">✅ সার্ভিস যোগ করুন</button>
    </form>
  </div>
</div>

<div class="section">
  <div class="section-title">📋 সব সার্ভিস (<%= services.length %>)</div>
  <% if (services.length === 0) { %>
    <p style="color:#64748b">কোনো সার্ভিস নেই।</p>
  <% } else { %>
    <div class="small-grid">
      <% services.forEach((s, idx) => { %>
        <div class="small-card" style="cursor:default;flex-direction:column;align-items:flex-start;gap:10px;padding:18px;<%= s.active ? '' : 'opacity:.7;border:2px dashed #dc2626' %>">
          
          <!-- হেডার -->
          <div style="display:flex;justify-content:space-between;width:100%;align-items:center">
            <div style="display:flex;align-items:center;gap:10px">
              <div style="width:44px;height:44px;border-radius:50%;background:#ecfdf5;display:flex;align-items:center;justify-content:center;font-size:22px"><%= s.icon || '🛠️' %></div>
              <div>
                <b style="font-size:15px"><%= s.name %></b>
                <p style="font-size:11px;color:#64748b">📁 <%= s.category %></p>
              </div>
            </div>
            
            <!-- টগল বাটন -->
            <form method="POST" action="/admin/services/toggle/<%= s._id %>" style="display:inline">
              <button type="submit" title="<%= s.active ? 'চালু আছে - বন্ধ করতে ক্লিক করুন' : 'বন্ধ আছে - চালু করতে ক্লিক করুন' %>" style="position:relative;display:inline-flex;align-items:center;background:<%= s.active ? '#10b981' : '#cbd5e1' %>;border:0;border-radius:20px;cursor:pointer;width:60px;height:28px;padding:0;transition:.3s">
                <span style="position:absolute;left:<%= s.active ? '34px' : '4px' %>;top:4px;width:20px;height:20px;background:#fff;border-radius:50%;transition:.3s;box-shadow:0 1px 3px rgba(0,0,0,.3)"></span>
              </button>
            </form>
          </div>

          <!-- স্ট্যাটাস টেক্সট -->
          <div style="width:100%;text-align:right;font-size:11px;font-weight:700;<%= s.active ? 'color:#10b981' : 'color:#dc2626' %>">
            <%= s.active ? '✅ চালু আছে' : '❌ বন্ধ আছে' %>
          </div>

          <% if (s.description) { %>
            <p style="font-size:12px;color:#64748b"><%= s.description %></p>
          <% } %>

          <!-- অপশন লিস্ট -->
          <div style="width:100%">
            <b style="font-size:12px;color:#0f5132">💰 অপশন:</b>
            <% s.options.forEach((o) => { %>
              <div style="display:flex;justify-content:space-between;font-size:12.5px;padding:4px 0;border-bottom:1px dashed #d1fae5">
                <span><%= o.label %></span>
                <b style="color:#10b981">৳ <%= o.price %></b>
              </div>
            <% }) %>
          </div>

          <!-- এডিট অপশন -->
          <details style="width:100%;background:#f0fdf4;border-radius:10px;padding:10px">
            <summary style="cursor:pointer;color:#2563eb;font-size:14px;font-weight:800;padding:4px 0;user-select:none">✏️ এডিট করুন</summary>
            <form method="POST" action="/admin/services/edit/<%= s._id %>" style="display:flex;flex-direction:column;gap:8px;margin-top:10px">
              <label style="font-size:12px;color:#64748b">আইকন ও নাম:</label>
              <div style="display:grid;grid-template-columns:70px 1fr;gap:6px">
                <input name="icon" value="<%= s.icon || '' %>" maxlength="4" style="padding:8px;border:1px solid #d1fae5;border-radius:6px;font-size:18px;text-align:center;font-family:inherit">
                <input name="name" value="<%= s.name %>" required style="padding:8px;border:1px solid #d1fae5;border-radius:6px;font-family:inherit;font-size:13px">
              </div>
              
              <label style="font-size:12px;color:#64748b">ক্যাটাগরি:</label>
              <input name="category" value="<%= s.category %>" required style="padding:8px;border:1px solid #d1fae5;border-radius:6px;font-family:inherit;font-size:13px">
              
              <label style="font-size:12px;color:#64748b">বর্ণনা:</label>
              <input name="description" value="<%= s.description || '' %>" style="padding:8px;border:1px solid #d1fae5;border-radius:6px;font-family:inherit;font-size:13px">

              <label style="font-size:12px;color:#64748b;margin-top:6px">অপশন ও দাম:</label>
              <% s.options.forEach((o, oidx) => { %>
                <div style="display:flex;gap:6px">
                  <input name="optionLabels" value="<%= o.label %>" style="flex:2;padding:8px;border:1px solid #d1fae5;border-radius:6px;font-family:inherit;font-size:12px">
                  <input name="optionPrices" type="number" value="<%= o.price %>" style="flex:1;padding:8px;border:1px solid #d1fae5;border-radius:6px;font-family:inherit;font-size:12px">
                </div>
              <% }) %>

              <button class="btn-yellow" style="justify-content:center;font-size:13px;padding:10px;margin-top:8px">💾 সেভ করুন</button>
            </form>
          </details>

          <!-- ডিলিট -->
          <form method="POST" action="/admin/services/delete/<%= s._id %>" onsubmit="return confirm('সার্ভিস ডিলিট করবেন?')" style="width:100%">
            <button class="btn-ghost" style="width:100%;justify-content:center;font-size:12px;padding:8px;background:#dc2626;border-color:#dc2626;color:#fff">🗑️ ডিলিট</button>
          </form>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<script>
function addOption() {
  const box = document.getElementById('optionsBox');
  const div = document.createElement('div');
  div.className = 'option-row';
  div.style.cssText = 'display:flex;gap:8px;margin-bottom:8px';
  div.innerHTML = `
    <input name="optionLabels" placeholder="অপশনের নাম" style="flex:2;padding:9px;border:1px solid #d1fae5;border-radius:6px;font-family:inherit">
    <input name="optionPrices" type="number" placeholder="দাম" style="flex:1;padding:9px;border:1px solid #d1fae5;border-radius:6px;font-family:inherit">
    <button type="button" onclick="removeOption(this)" style="padding:9px 12px;background:#dc2626;color:#fff;border:0;border-radius:6px;cursor:pointer">✕</button>
  `;
  box.appendChild(div);
}

function removeOption(btn) {
  const rows = document.querySelectorAll('.option-row');
  if (rows.length > 1) {
    btn.parentElement.remove();
  } else {
    alert('অন্তত একটা অপশন থাকতে হবে');
  }
}
</script>

</body></html>