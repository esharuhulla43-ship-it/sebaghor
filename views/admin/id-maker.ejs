<%- include('../partials/head', { cssFile: 'dashboard.css', bodyClass: 'dash' }) %>

<div class="topbar">
  <div class="left"><a href="/admin/dashboard" style="color:#0f5132;font-weight:700">⬅ ড্যাশবোর্ডে ফিরুন</a></div>
  <div class="right"><b style="color:#0f5132">🪪 আইডি মেইক ম্যানেজমেন্ট</b></div>
</div>

<div class="section">
  <div class="section-title">➕ নতুন টেমপ্লেট যোগ করুন</div>
  <div class="small-card" style="cursor:default;padding:20px">
    <form method="POST" action="/admin/id-maker/add" enctype="multipart/form-data" style="display:flex;flex-direction:column;gap:12px">
      <input name="name" placeholder="টেমপ্লেটের নাম (যেমন: জাতীয় পরিচয়পত্র)" required style="padding:11px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit">
      <input name="description" placeholder="বর্ণনা (ঐচ্ছিক)" style="padding:11px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit">
      <input name="price" type="number" placeholder="দাম (৳)" required style="padding:11px;border:1px solid #d1fae5;border-radius:8px;font-family:inherit">
      <div style="background:#f0fdf4;padding:12px;border-radius:8px">
        <label style="font-size:13px;color:#0f5132;font-weight:700">🖼️ ব্ল্যাংক টেমপ্লেট ছবি (JPG/PNG):</label>
        <input type="file" name="templateImage" accept="image/*" required style="margin-top:8px;width:100%">
      </div>
      <button class="btn-yellow" style="justify-content:center;padding:12px;font-size:15px">✅ টেমপ্লেট যোগ করুন</button>
    </form>
  </div>
</div>

<div class="section">
  <div class="section-title">📋 সব টেমপ্লেট (<%= templates.length %>)</div>
  <% if (templates.length === 0) { %>
    <p style="color:#64748b">কোনো টেমপ্লেট নেই।</p>
  <% } else { %>
    <div class="small-grid">
      <% templates.forEach(t => { %>
        <div class="small-card" style="cursor:default;flex-direction:column;gap:10px;padding:18px;<%= t.active ? '' : 'opacity:.7;border:2px dashed #dc2626' %>">
          <img src="/uploads/<%= t.templateImage %>" alt="Template" style="width:100%;height:150px;object-fit:cover;border-radius:8px;border:1px solid #d1fae5">
          <div style="display:flex;justify-content:space-between;width:100%;align-items:center">
            <b style="font-size:15px"><%= t.name %></b>
            <form method="POST" action="/admin/id-maker/toggle/<%= t._id %>" style="display:inline">
              <button type="submit" style="position:relative;display:inline-flex;align-items:center;background:<%= t.active ? '#10b981' : '#cbd5e1' %>;border:0;border-radius:20px;cursor:pointer;width:60px;height:28px;padding:0">
                <span style="position:absolute;left:<%= t.active ? '34px' : '4px' %>;top:4px;width:20px;height:20px;background:#fff;border-radius:50%;transition:.3s;box-shadow:0 1px 3px rgba(0,0,0,.3)"></span>
              </button>
            </form>
          </div>
          <% if (t.description) { %><p style="font-size:12px;color:#64748b"><%= t.description %></p><% } %>
          <p style="color:#10b981;font-weight:700;font-size:16px">৳ <%= t.price %></p>

          <details style="width:100%;background:#f0fdf4;border-radius:10px;padding:10px">
            <summary style="cursor:pointer;color:#2563eb;font-size:13px;font-weight:700">✏️ এডিট</summary>
            <form method="POST" action="/admin/id-maker/edit/<%= t._id %>" style="display:flex;flex-direction:column;gap:6px;margin-top:8px">
              <input name="name" value="<%= t.name %>" required style="padding:8px;border:1px solid #d1fae5;border-radius:6px;font-family:inherit;font-size:13px">
              <input name="description" value="<%= t.description %>" placeholder="বর্ণনা" style="padding:8px;border:1px solid #d1fae5;border-radius:6px;font-family:inherit;font-size:13px">
              <input name="price" type="number" value="<%= t.price %>" required style="padding:8px;border:1px solid #d1fae5;border-radius:6px;font-family:inherit;font-size:13px">
              <label style="font-size:12px"><input type="checkbox" name="active" <%= t.active ? 'checked' : '' %>> চালু</label>
              <button class="btn-yellow" style="justify-content:center;font-size:13px;padding:8px">💾 সেভ করুন</button>
            </form>
          </details>

          <form method="POST" action="/admin/id-maker/delete/<%= t._id %>" onsubmit="return confirm('ডিলিট করবেন?')" style="width:100%">
            <button class="btn-ghost" style="width:100%;justify-content:center;font-size:12px;padding:8px;background:#dc2626;border-color:#dc2626;color:#fff">🗑️ ডিলিট</button>
          </form>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

</body></html>